rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Cho phép đọc/ghi collection sessions và sub-collection messages
    // (Hỗ trợ cả chế độ trải nghiệm khách, demo và người dùng đã đăng nhập)
    match /sessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
