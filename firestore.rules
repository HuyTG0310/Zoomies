rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kiểm tra người dùng đã đăng nhập hay chưa
    function isAuthenticated() {
      return request.auth != null;
    }

    // Kiểm tra chủ sở hữu ca bệnh
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Collection sessions (Mỗi ca bệnh là 1 document)
    match /sessions/{sessionId} {
      // Người dùng được phép đọc ca bệnh của chính mình
      allow read: if isOwner(resource.data.userId);
      
      // Tạo / cập nhật chủ yếu thông qua Cloud Functions (Admin SDK), 
      // cho phép client cập nhật nếu là chủ ca bệnh khi cần
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);

      // Sub-collection sessions/{sessionId}/messages (Lịch sử chat)
      match /messages/{messageId} {
        // Cho phép đọc / ghi tin nhắn nếu sở hữu session
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }
  }
}

